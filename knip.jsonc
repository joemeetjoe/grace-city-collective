{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/main.tsx is found through index.html by knip's vite plugin; the shots
  // and perf scripts under tools/ are run by hand or from package.json and
  // import nothing from src, so they are entries of their own. The Lighthouse
  // CI configs are loaded by `lhci --config` (tools/perf/lighthouse.mjs) and
  // reach lighthouseProfiles.cjs through their own require.
  // docs/design/issue-134/measure.mjs is the #134 spike's measurement script, run by hand like the tools.
  "entry": ["tools/**/*.mjs", "tools/perf/lighthouserc.*.cjs", "docs/design/issue-134/measure.mjs"],
  // Tuning constants are exported for reading (an easing, a duration, a size)
  // and used only by the module that declares them. An export nothing else
  // imports and the module itself does not use is still reported.
  "ignoreExportsUsedInFile": true,
  // @fontsource-variable/geist ships no latin-only css to @import, so
  // src/index.css names its latin file in a url() (#105), which knip does
  // not follow.
  "ignoreDependencies": ["@fontsource-variable/geist"]
}
